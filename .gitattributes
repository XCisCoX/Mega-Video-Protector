# Normalize text files to LF (the repo is developed on Linux, Windows, and in
# Docker); declare binary assets so git never mangles them.
* text=auto

*.cpp text eol=lf
*.hpp text eol=lf
*.c   text eol=lf
*.h   text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.kts text eol=lf
*.kt  text eol=lf
*.sh  text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf

*.png binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
*.vvp binary
